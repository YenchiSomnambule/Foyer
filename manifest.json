{
  "manifest_version": 3,
  "name": "Foyer",
  "version": "2.4.0",
  "description": "Your websites in a clean new-tab grid — pages, folders, quick search, weather, and free cross-device sync.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "bookmarks"],
  "optional_permissions": ["topSites"],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.bigdatacloud.net/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
